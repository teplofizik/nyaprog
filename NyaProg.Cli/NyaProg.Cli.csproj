<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NyaProg.Cli</AssemblyName>
    <RootNamespace>NyaProg.Cli</RootNamespace>
    <!-- Кроссплатформенный headless-раннер (Windows/Linux/macOS). -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Programmer.Abstractions\Programmer.Abstractions.csproj" />
    <ProjectReference Include="..\NyaProg.Core\NyaProg.Core.csproj" />
    <ProjectReference Include="..\NyaProg.Hosting\NyaProg.Hosting.csproj" />
    <ProjectReference Include="..\NyaProg.Presentation\NyaProg.Presentation.csproj" />
  </ItemGroup>

  <!-- Встроенные модули: только сборка; сами DLL деплоятся в plugins. -->
  <ItemGroup>
    <ProjectReference Include="..\NyaProg.Modules.Internal\NyaProg.Modules.Internal.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\NyaProg.Modules.Net\NyaProg.Modules.Net.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\NyaProg.Plugins.Sample\NyaProg.Plugins.Sample.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\NyaProg.Plugins.Esp32\NyaProg.Plugins.Esp32.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\NyaProg.Plugins.SettingsGen\NyaProg.Plugins.SettingsGen.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\NyaProg.Plugins.FileInfo\NyaProg.Plugins.FileInfo.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <ItemGroup>
      <PluginFiles Include="..\NyaProg.Modules.Internal\bin\$(Configuration)\*.dll" Exclude="..\NyaProg.Modules.Internal\bin\$(Configuration)\Programmer.Abstractions.dll" />
      <PluginFiles Include="..\NyaProg.Modules.Net\bin\$(Configuration)\*.dll" Exclude="..\NyaProg.Modules.Net\bin\$(Configuration)\Programmer.Abstractions.dll" />
      <PluginFiles Include="..\NyaProg.Plugins.Sample\bin\$(Configuration)\NyaProg.Plugins.Sample.dll" />
      <PluginFiles Include="..\NyaProg.Plugins.SettingsGen\bin\$(Configuration)\NyaProg.Plugins.SettingsGen.dll" />
      <PluginFiles Include="..\NyaProg.Plugins.FileInfo\bin\$(Configuration)\NyaProg.Plugins.FileInfo.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)plugins" />
    <!-- Убрать возможный устаревший корневой System.IO.Ports (нужен RID-вариант из runtimes/). -->
    <Delete Files="$(OutDir)plugins\System.IO.Ports.dll" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />

    <!-- ESP32: всё дерево (включая runtimes/), кроме корневых System.IO.Ports и Abstractions. -->
    <ItemGroup>
      <Esp32Files Include="..\NyaProg.Plugins.Esp32\bin\$(Configuration)\**\*.dll"
                  Exclude="..\NyaProg.Plugins.Esp32\bin\$(Configuration)\Programmer.Abstractions.dll;..\NyaProg.Plugins.Esp32\bin\$(Configuration)\System.IO.Ports.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(Esp32Files)" DestinationFiles="@(Esp32Files->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
