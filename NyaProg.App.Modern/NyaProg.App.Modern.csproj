<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NyaProg.App.Modern</AssemblyName>
    <RootNamespace>NyaProg.App.Modern</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Programmer.Abstractions\Programmer.Abstractions.csproj" />
    <ProjectReference Include="..\NyaProg.Core\NyaProg.Core.csproj" />
    <ProjectReference Include="..\NyaProg.Presentation\NyaProg.Presentation.csproj" />
    <ProjectReference Include="..\NyaProg.Hosting\NyaProg.Hosting.csproj" />
  </ItemGroup>

  <!-- Встроенные модули: только сборка; сами DLL деплоятся в plugins. -->
  <ItemGroup>
    <ProjectReference Include="..\NyaProg.Modules.Internal\NyaProg.Modules.Internal.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\NyaProg.Modules.Net\NyaProg.Modules.Net.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\NyaProg.Plugins.Sample\NyaProg.Plugins.Sample.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <ItemGroup>
      <PluginFiles Include="..\NyaProg.Modules.Internal\bin\$(Configuration)\*.dll" Exclude="..\NyaProg.Modules.Internal\bin\$(Configuration)\Programmer.Abstractions.dll" />
      <PluginFiles Include="..\NyaProg.Modules.Net\bin\$(Configuration)\*.dll" Exclude="..\NyaProg.Modules.Net\bin\$(Configuration)\Programmer.Abstractions.dll" />
      <PluginFiles Include="..\NyaProg.Plugins.Sample\bin\$(Configuration)\NyaProg.Plugins.Sample.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)plugins" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
