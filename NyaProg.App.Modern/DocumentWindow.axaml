<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NyaProg.App.Modern.DocumentWindow"
        Width="780" Height="600"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto" Margin="12">

    <Border Grid.Row="0" Background="#FAFAFA" CornerRadius="8"
            BorderBrush="#33000000" BorderThickness="1" Padding="8">
      <ScrollViewer>
        <StackPanel x:Name="Body" Spacing="8" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OpenExternal" Content="Открыть внешне" Click="OnOpenExternal" IsVisible="False" />
      <Button Content="Закрыть" MinWidth="110" Click="OnClose" />
    </StackPanel>

  </Grid>
</Window>
