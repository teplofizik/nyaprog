<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaProg.App.Modern.Views.TargetSelectView">

  <Grid RowDefinitions="Auto,*" Margin="12">
    <TextBlock Grid.Row="0" Text="Что прошиваем?" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Targets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="6"
                    Click="OnCardClick">
              <Border Width="320" Height="260" CornerRadius="8"
                      BorderBrush="#33000000" BorderThickness="1"
                      Background="#FAFAFA" Padding="10">
                <Grid RowDefinitions="160,*">
                  <Image Grid.Row="0" Stretch="Uniform"
                         Source="{Binding PhotoPath, Converter={StaticResource PathToBitmap}}" />
                  <StackPanel Grid.Row="1" Spacing="4" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Readme}" TextWrapping="Wrap"
                               Opacity="0.7" FontSize="12" MaxHeight="50" />
                  </StackPanel>
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
