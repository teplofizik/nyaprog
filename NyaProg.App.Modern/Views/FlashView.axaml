<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NyaProg.App.Modern.Views.FlashView">

  <Grid ColumnDefinitions="*,320" Margin="12">

    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto">

      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="Программатор" FontWeight="Bold" />
        <ComboBox Width="320" HorizontalAlignment="Left"
                  ItemsSource="{Binding Programmers}"
                  SelectedItem="{Binding Programmer, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0">
        <Button Content="⟳ Обновить списки" HorizontalAlignment="Left" Click="OnRefresh" />
        <ItemsControl ItemsSource="{Binding Options}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="150,*" Margin="0,3" IsVisible="{Binding IsVisible}">
              <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Width="240" HorizontalAlignment="Left"
                        IsVisible="{Binding IsList}"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
              <CheckBox Grid.Column="1" IsVisible="{Binding IsBool}"
                        IsChecked="{Binding Checked, Mode=TwoWay}" />
              <TextBox Grid.Column="1" Width="240" HorizontalAlignment="Left"
                       IsVisible="{Binding IsText}"
                       Text="{Binding Text, Mode=TwoWay}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Grid.Row="2" Text="Этапы прошивки" FontWeight="Bold" Margin="0,14,0,6" />

      <ScrollViewer Grid.Row="3">
        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,2" Padding="10,6" CornerRadius="4"
                      Background="#F5F5F5" BorderBrush="#22000000" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                           Fill="{Binding StatusBrush}" Stroke="#66000000" StrokeThickness="1" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Result}" VerticalAlignment="Center"
                             Opacity="0.6" FontSize="12" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
        <Button Content="Старт" MinWidth="120" Background="#C8E6C9"
                Command="{Binding StartCommand}" IsVisible="{Binding !Running}" />
        <Button Content="Отмена" MinWidth="120" Background="#FFCDD2"
                Command="{Binding CancelCommand}" IsVisible="{Binding Running}" />
        <Button Content="Документ" MinWidth="120" Click="OnDocument" IsVisible="{Binding HasDoc}" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
      </StackPanel>

    </Grid>

    <Border Grid.Column="1" Margin="12,0,0,0" Padding="10"
            Background="#FAFAFA" CornerRadius="8"
            BorderBrush="#33000000" BorderThickness="1">
      <Grid RowDefinitions="*,Auto">
        <Image Grid.Row="0" Stretch="Uniform"
               Source="{Binding PhotoPath, Converter={StaticResource PathToBitmap}}" />
        <TextBlock Grid.Row="1" Text="{Binding Readme}" TextWrapping="Wrap"
                   Opacity="0.8" Margin="0,8,0,0" MaxHeight="160" />
      </Grid>
    </Border>

  </Grid>
</UserControl>
