<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>NyaProg.Modules.Net</AssemblyName>
    <RootNamespace>Programmer.Modules.Net</RootNamespace>
    <!-- Чтобы зависимости (System.Text.Json и т.п.) попадали в output и деплоились в plugins. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Programmer.Abstractions\Programmer.Abstractions.csproj" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
